# ====================== 1.企业微信推送配置 ======================
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=替换成你的机器人key
WECHAT_MSG_TYPE=markdown

# ====================== 2.股票列表（英文逗号分隔，无空格） ======================
STOCK_LIST=603679.SH,688321.Sh,002688.SZ

# ====================== 3.报告全局控制（解决只发大盘、个股丢失） ======================
REPORT_SUMMARY_ONLY=false
SINGLE_STOCK_NOTIFY=true
REPORT_TYPE=full

# ====================== 4.筹码分布开关 ======================
ENABLE_CHIP_DISTRIBUTION=true
CHIP_STAT_DAYS=60
CHIP_DECAY_FACTOR=1.0
CHIP_SEND_IMAGE=true

# ====================== 5.缠论全套配置（重点） ======================
ENABLE_CHAN_LUN=true
CHAN_LUN_MULTI_PERIOD=true
CHAN_LUN_DRAW_IMG=true
CHAN_DAY_PERIOD=60
CHAN_30M_PERIOD=21

# ====================== 6.全技术指标开关 ======================
FULL_TECH_INDICATOR=true
SHOW_MA=true
SHOW_MACD=true
SHOW_BOLL=true
SHOW_KDJ=true
SHOW_VOL=true

# ====================== 7.数据源防限流 ======================
ENABLE_EASTMONEY_PATCH=true
MAX_WORKERS=1
REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance

# ====================== 8.大模型API密钥 ======================
DEEPSEEK_API_KEY=sk-ffc3ace0bfbf456ea4b11e851da8c315
MINIMAX_API_KEYS=sk-替换你的minimax密钥

# ====================== 9.新闻搜索API ======================
SERPAPI_API_KEY=214a8e31b413d9da8838bd36d2b6a266540eba4c765e61c64590ea1824cf8e17
